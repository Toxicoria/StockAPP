# ==============================================================================
# 🔐 StockAPP - Plantilla de Variables de Entorno para Producción
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env en el servidor:
#    cp .env.example .env
# 2. Genera contraseñas y secretos seguros con:
#    openssl rand -hex 32
# 3. Nunca subas el archivo .env resultante a Git.
# ==============================================================================

# --- Base de Datos PostgreSQL ---
DB_USER=stock_admin
DB_PASSWORD=reemplazar_con_password_aleatoria_fuerte_de_db
DB_NAME=stock_db

# --- Seguridad de la Aplicación ---
# Secreto para firmar tokens JWT (generar con: openssl rand -hex 32)
JWT_SECRET=reemplazar_con_un_string_largo_y_aleatorio_64_caracteres

# Clave secreta para cifrado interno de configuraciones (generar con: openssl rand -hex 32)
CONFIG_SECRET_KEY=reemplazar_con_otra_clave_aleatoria_64_caracteres

# --- Puertos Expuestos en el Host ---
# Puerto para la API / Gateway de stock-api (usado por la app de escritorio)
PORT_API=3000

# Puerto para el panel web de administración
PORT_ADMIN=5173

# --- Integración Tailscale (Opcional) ---
# Si utilizas Tailscale para la red privada y generación automática de auth keys:
# TAILSCALE_API_KEY=tskey-api-k...
# TAILSCALE_CLIENT_ID=
# TAILSCALE_CLIENT_SECRET=
# TAILSCALE_TAILNET=tu-organizacion.org.github
